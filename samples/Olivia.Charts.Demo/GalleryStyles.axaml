<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button.action, Button.navItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource ChartText}" />
    <Setter Property="Background" Value="{DynamicResource ChartSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChartBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.action:pointerover, Button.navItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource ChartHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChartAccent}" />
  </Style>
  <Style Selector="Button.action:pressed, Button.navItem:pressed">
    <Setter Property="Background" Value="{DynamicResource ChartSelected}" />
  </Style>
  <Style Selector="Button.action:focus-visible, Button.navItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ChartAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.action.primary">
    <Setter Property="Background" Value="{DynamicResource ChartPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChartPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource ChartOnPrimary}" />
  </Style>
  <Style Selector="Button.action.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource ChartPrimaryHover}" />
  </Style>
  <Style Selector="Button.navItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.navItem.selected">
    <Setter Property="Background" Value="{DynamicResource ChartSelected}" />
    <Setter Property="Foreground" Value="{DynamicResource ChartAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.action:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource ChartSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChartBorder}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
</Styles>
